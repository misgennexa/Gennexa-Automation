            ],
            "formula_cols": {
              "Campaign": "=IFERROR(_xlfn.XLOOKUP(Table3[[#This Row],[UserName]],RAW!A:A,RAW!J:J),\"\")",
              "Team Lead": "=IFERROR(_xlfn.XLOOKUP(Table3[[#This Row],[UserName]],RAW!A:A,RAW!B:B),\"\")",
              "Calls Answered": "=SUMIFS(Table1[Unique ID],Table1[Date],Table3[[#This Row],[Date]],Table1[User ID],Table3[[#This Row],[UserName]],Table1[Call Status],\"CONNECT\",Table1[Unique ID],1)",
              "CIG": "=SUMIFS(RAW!F:F,RAW!I:I,Table3[[#This Row],[Date]],RAW!A:A,Table3[[#This Row],[UserName]],RAW!H:H,1)",
              "Tos": "=Table3[[#This Row],[Staff Time]]-(Table3[[#This Row],[Tea]]+Table3[[#This Row],[Lunch]]+Table3[[#This Row],[Bio]])"
            },
            "data_start_row": 2
          },
          "RAW": {
            "headers": [
              "User ID",
              "Team Lead",
              "UID",
              "Branch Code",
              "Customer Status",
              "CIG",
              "Call Status",
              "Unique ID",
              "Date",
              "No",
              "Phone Number",
              "RecID",
              "Added On",
