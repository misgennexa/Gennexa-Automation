              "NET_WEIGHT",
              "LOAN_AMOUNT",
              "BALANCE_AMOUNT",
              "INTEREST_DUE",
              "TOTAL_DUES",
              "ARC_STATUS",
              "ADDITIONAL_AMOUNT_REQUIRED_FOR_RENEWAL",
              "ADDITIONAL_GOLD_REQUIRED_FOR_RENEWAL",
              "CATAGORY",
              "CATEGORY2",
              "NPALOANID",
              "RefID",
              "PrimaryNo",
              "Secondary",
              "PrimaryFlag",
              "Customer_Status",
              "Cust_status",
              "Comments",
              "CUSTOMERCLUB",
              "Customer_NCS",
              "Customer_NCS2",
              "SMS_PUSHED",
              "Verified Customer"
            ],
            "formula_cols": {
              "User ID": "=IF(OR(S2=\"\", S2=\"-\", ISBLANK(S2)),\n    \"NoEID\",\n    IF(S2=\"not used\",\n        SUBSTITUTE(LEFT(W2,6),\" \",\"\"),\n        SUBSTITUTE(LEFT(S2,6),\" \",\"\")\n    )\n)",
              "Team Lead": "=IFERROR(_xlfn.XLOOKUP(Table1[[#This Row],[User ID]],'Lookup page'!J:J,'Lookup page'!N:N),\"\")",
              "UID": "=IFERROR(CONCATENATE(Table1[[#This Row],[Branch Code]],Table1[[#This Row],[SCHEME]],Table1[[#This Row],[LOAN_NO]]),0)",
              "Branch Code": "=IFERROR(_xlfn.XLOOKUP(Table1[[#This Row],[BRANCH_NAME]],'Lookup page'!B:B,'Lookup page'!A:A),0)",
              "Customer Status": "=IF(Table1[[#This Row],[Customer_Status]]=\"\",\"Non contactable\", Table1[[#This Row],[Customer_Status]])",
              "CIG": "=COUNTIF(Table1[[#This Row],[Customer Status]],\"Complete Info Given\")",
              "Call Status": "=_xlfn.XLOOKUP(Table1[[#This Row],[Customer Status]],'Lookup page'!E:E,'Lookup page'!F:F)",
              "Unique ID": "=IF(COUNTIF($C$2:$C$44086, C2)=1, 1, IF(AND(COUNTIF($C$2:C2, C2)=1, G2<>\"Connect\"), 1, IF(AND(G2=\"Connect\", COUNTIF($C$2:C2, C2)=1), 1, 0)))",
              "Date": "=INT(Table1[[#This Row],[Called Time]])",
              "Verified Customer": "=COUNTIF(Table1[[#This Row],[Cust_status]],\"Verified Customer\")"
            },
            "data_start_row": 2
          },
          "Lookup page": {
